# pnpm settings for the CreatorDNA monorepo.
# Keep node_modules isolated (pnpm default) - every package declares what it needs.
auto-install-peers=true
strict-peer-dependencies=false
# Do not let a script try to run a postinstall we did not audit.
enable-prepost-scripts=false

# pnpm 10 blocks dependency build scripts by default. Allowlist only what the
# toolchain genuinely needs to place a native binary:
#   esbuild           - required by Vite and tsx (platform binary is linked in postinstall)
only-built-dependencies[]=esbuild
