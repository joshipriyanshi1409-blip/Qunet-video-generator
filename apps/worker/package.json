{
  "name": "@creatordna/worker",
  "version": "0.1.0",
  "private": true,
  "description": "CreatorDNA Studio background worker (BullMQ + Redis; Remotion/FFmpeg in later phases).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "scale:worker": "tsx scripts/scaleWorker.ts"
  },
  "dependencies": {
    "@creatordna/shared": "workspace:*",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "zod": "^3.25.76",
    "@creatordna/render": "workspace:*",
    "firebase-admin": "^13.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
