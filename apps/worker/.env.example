# CreatorDNA Studio - worker environment
# Copy to .env and fill in. NEVER commit the real .env.

NODE_ENV=development

# --- logging ---------------------------------------------------------------
LOG_LEVEL=debug
# Pretty-print logs in development only. Keep this false in production so logs
# stay machine-readable JSON.
LOG_PRETTY=true

# --- redis / bullmq --------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true
# BullMQ key prefix - keeps CreatorDNA keys separate in a shared Redis.
QUEUE_PREFIX=creatordna
WORKER_CONCURRENCY=4
# Retries per job. Only the failed stage re-runs; cached assets are reused.
JOB_MAX_ATTEMPTS=3
SHUTDOWN_TIMEOUT_MS=15000

# --- render pipeline -------------------------------------------------------
# Where the worker writes job documents, assets and scratch files when Firebase
# is not configured. Three subdirectories appear under it: render-jobs.json,
# assets/renders/<uid>/<jobId>/..., and work/<jobId>/.
WORKER_DATA_DIR=.data
# The API serves the asset directory read-only at this path, so a development
# render is playable in the browser without a bucket. Must match the API's
# RENDER_ASSET_MOUNT. Leave blank to record no URL at all.
RENDER_ASSET_BASE_URL=/api/v1/render-assets
# auto   - use ffmpeg when the binary runs, the mock composer otherwise (default)
# ffmpeg - require ffmpeg, and fail at boot if it is not runnable
# mock   - always the mock composer: a valid MP4 container, no encoded video
RENDER_COMPOSER=auto
# Path to the ffmpeg binary when it is not on PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg

# --- demo mode --------------------------------------------------------------
# Serve every render stage from a pre-baked cache instead of a model. A demo
# that spends quota is not a demo: with this on, a render finishes in seconds
# with no API key. The cache is warmed by `pnpm --filter @creatordna/api
# seed:demo` and must be the same path in both processes.
# Refused in production by the env validator.
DEMO_MODE=false
# Where the cache lives. Defaults to <WORKER_DATA_DIR>/demo-cache.
# DEMO_CACHE_DIR=.data/demo-cache

# --- firebase admin (worker writes assets + job documents) -----------------
# Required in production. Leave blank for local development without Firebase.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# PEM key. Keep the literal \n escapes - they are converted at boot.
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# --- media model credentials -----------------------------------------------
# Optional. With no key the render still runs and the assets, voice and music
# stages fall back to their mock generators - which the boot log states per slot,
# so "the video has stills instead of clips" is a line you can read rather than a
# surprise at the end of a render.
# Used by Veo (clips) and the Gemini TTS model (voice-over).
GEMINI_API_KEY=
# Prebuilt TTS voice name. A speaker such as `Kore`, not a model id.
TTS_VOICE_NAME=
# Lyria 2 is a Vertex AI model: it authenticates with OAuth, not an API key.
# Supply a full header value, e.g. `Bearer ya29....`, minted from a service
# account (or `gcloud auth print-access-token` for a local run). This process
# does not refresh it - a deployment that outlives the token needs to re-mint.
LYRIA_AUTHORIZATION=
# The Vertex base URL Lyria is called on.
LYRIA_BASE_URL=https://us-central1-aiplatform.googleapis.com/v1

# --- media model timing -----------------------------------------------------
# How often to poll a Veo long-running operation.
MEDIA_POLL_INTERVAL_MS=5000
# How long to wait for one media call before failing the stage. Keep this under
# the BullMQ lock duration (300s): a render that outlives its own lock is a
# render another worker starts again from the beginning.
MEDIA_TIMEOUT_MS=240000

# --- model ids -------------------------------------------------------------
# NEVER hard-code these in source. Fill in the ids that are currently available
# in your Google AI / Vertex account and check the official docs for the exact
# model names before setting them.
GEMINI_TEXT_MODEL=
GEMINI_LIVE_MODEL=
VEO_MODEL=
LYRIA_MODEL=
TTS_MODEL=
TRANSCRIBE_MODEL=
# Used when the primary text model is unavailable.
AI_FALLBACK_MODEL=
