{
  "name": "@creatordna/web",
  "version": "0.1.0",
  "private": true,
  "description": "CreatorDNA Studio web app (React 19 + Vite + Tailwind v4).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
