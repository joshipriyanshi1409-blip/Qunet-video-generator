# CreatorDNA Studio - web environment
# Copy to .env and fill in. NEVER commit the real .env.

# --- API --------------------------------------------------------------------
# Leave empty to call the API through the Vite dev-server proxy (recommended for
# local development). Set an absolute URL only when the API is on another origin.
VITE_API_URL=

# Where the Vite dev server proxies /api, /health and /ws.
VITE_API_PROXY_TARGET=http://127.0.0.1:4000

# --- live voice coach -------------------------------------------------------
# Path of the coaching WebSocket. Must match the API's VOICE_COACH_WS_PATH.
# Left empty it defaults to /ws/voice-coach, which the proxy above forwards.
VITE_VOICE_COACH_WS_PATH=/ws/voice-coach

# --- firebase (client SDK) --------------------------------------------------
# Leave blank to run the UI without Firebase (auth arrives in a later phase).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# WebSocket API origin for separately hosted web (e.g. wss://api.example.com).
VITE_WS_ORIGIN=
