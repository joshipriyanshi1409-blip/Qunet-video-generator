{
  "name": "@creatordna/api",
  "version": "0.1.0",
  "private": true,
  "description": "CreatorDNA Studio REST + WebSocket API (Express, ws, BullMQ producers).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts",
    "seed:trends": "tsx scripts/seedTrends.ts",
    "seed:demo": "tsx scripts/seedDemo.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@creatordna/prompts": "workspace:*",
    "@creatordna/shared": "workspace:*",
    "bullmq": "^5.34.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.4.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "ws": "^8.18.0",
    "zod": "^3.25.76",
    "@creatordna/render": "workspace:*"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.13",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
