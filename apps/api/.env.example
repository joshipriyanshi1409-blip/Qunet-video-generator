# CreatorDNA Studio - API environment
# Copy to .env and fill in. NEVER commit the real .env.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
API_PREFIX=/api/v1

# --- CORS ------------------------------------------------------------------
# Comma-separated allowlist of browser origins. The Vite dev server origin must
# be listed here or the browser will block the response.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- logging ---------------------------------------------------------------
LOG_LEVEL=debug
# Pretty-print logs in development only. Keep this false in production so logs
# stay machine-readable JSON.
LOG_PRETTY=true

# --- redis / bullmq --------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true
# BullMQ key prefix - keeps CreatorDNA keys separate in a shared Redis.
QUEUE_PREFIX=creatordna

# --- http ------------------------------------------------------------------
BODY_LIMIT=256kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
SHUTDOWN_TIMEOUT_MS=10000

# --- firebase admin --------------------------------------------------------
# Required in production. Leave blank for local development without Firebase
# (the API still boots; token verification then returns a clear 503 and /health
# reports firebase: not_configured).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# PEM key. Keep the literal \n escapes - they are converted at boot.
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# Alternative to the two lines above: point at a service-account JSON file.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- dev-only auth bypass --------------------------------------------------
# DANGER: when true, protected endpoints trust the `x-dev-uid` header instead of
# a Firebase ID token. The API refuses to boot with this enabled in production.
DEV_AUTH_BYPASS=true

# --- dev-only stub model ---------------------------------------------------
# DANGER: when true, DNA extraction uses the fake client in
# `src/services/ai/stubClient.ts` instead of a real model, so the whole /dna
# flow can be demoed without an API key. The API refuses to boot with this
# enabled in production. Delete once a real model id is configured.
AI_STUB_CLIENT=false

# --- phase 4: trends, remix, hook lab --------------------------------------
# How long one creator's trend ranking stays fresh (default 1 hour).
TRENDS_CACHE_TTL_MS=3600000
# How long one remix / hook set stays fresh.
TREND_CACHE_TTL_MS=1800000
# Requests per window for the model-backed endpoints (per IP).
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=60000
# How much of a blended relevance score the model owns (0-1); the rest is the
# deterministic heuristic in @creatordna/shared.
TREND_MODEL_WEIGHT=0.5
# Dev-only catalogue file when Firebase is not configured.
TRENDS_STORE_PATH=.data/trends.json
# Dev-only project file when Firebase is not configured. Holds each creator's
# remix -> mirror -> improve -> approve loop, including every version.
PROJECTS_STORE_PATH=.data/projects.json

# --- phase 7: render pipeline ----------------------------------------------
# Directory the worker writes render assets into when Firebase Storage is not
# configured. Served read-only at RENDER_ASSET_MOUNT below. In production the
# worker uploads to Storage instead and this mount is unused.
RENDER_ASSET_DIR=.data/assets
# Set to an empty string to disable the dev asset mount entirely.
RENDER_ASSET_MOUNT=/api/v1/render-assets
# Composer for the demo seed script's golden render. Same three values as the
# worker's RENDER_COMPOSER: auto | ffmpeg | mock.
RENDER_COMPOSER=auto
# Path to ffmpeg for the seed script, when it is not on PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg
# Where the demo render cache lives. Written by `pnpm --filter @creatordna/api
# seed:demo`, read by the worker when DEMO_MODE=true. Deliberately outside
# RENDER_ASSET_DIR: the cache is not an asset the browser should fetch.
DEMO_CACHE_DIR=.data/demo-cache

# --- phase 6: live voice coach ---------------------------------------------
# Path the coaching WebSocket is mounted on. Same host/port as /ws.
VOICE_COACH_WS_PATH=/ws/voice-coach
# The Live API version in the WebSocket path. Google's current get-started page
# shows v1beta; older pages and community posts show v1alpha. If a live session
# never reaches setupComplete, try the other one:
#   https://ai.google.dev/gemini-api/docs/live-api/get-started-websocket
GEMINI_LIVE_API_VERSION=v1beta
# Override only for a proxy or tests. Leave blank for Google's endpoint.
# GEMINI_LIVE_BASE_URL=

# --- model ids -------------------------------------------------------------
# NEVER hard-code these in source. Fill in the ids that are currently available
# in your Google AI / Vertex account and check the official docs for the exact
# model names before setting them. Leave blank until Phase 3 wires the AI
# wrapper - a missing id fails loudly at call time instead of falling back to a
# hard-coded default.
#
# The API itself only uses GEMINI_TEXT_MODEL and GEMINI_LIVE_MODEL. VEO_MODEL,
# LYRIA_MODEL, TTS_MODEL and TRANSCRIBE_MODEL are read by the *worker*, which is
# where the render pipeline runs - set them there, not here.
GEMINI_TEXT_MODEL=
GEMINI_LIVE_MODEL=
VEO_MODEL=
LYRIA_MODEL=
TTS_MODEL=
TRANSCRIBE_MODEL=
# Used when the primary text model is unavailable.
AI_FALLBACK_MODEL=

# --- phase 9: the learning loop --------------------------------------------
# How many recent signals one learning run reasons over. Bounded because the
# prompt carries every signal verbatim.
DNA_SIGNAL_LIMIT=30
# Ceiling on proposals per run, independent of what the model returns.
DNA_MAX_SUGGESTIONS=6
# How often the loop sweeps for creators with unseen signals. Default 6 hours.
DNA_LEARN_INTERVAL_MS=21600000
# Creators one sweep touches before the next one picks up the rest.
DNA_LEARN_BATCH_SIZE=25
# Set false to run the loop only when a creator asks (tests, CI).
DNA_LEARN_ENABLED=true
