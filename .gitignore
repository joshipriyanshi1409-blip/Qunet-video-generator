# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
out/
*.tsbuildinfo

# env / secrets - never commit real values
.env
.env.*
!.env.example
!.env.*.example

# logs & coverage
*.log
npm-debug.log*
pnpm-debug.log*
coverage/

# editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# misc
.turbo/
.cache/
.vite/
*.local

# local data store - regenerated by `seed:demo`, never committed
.data/

# keys / credentials
*.pem
*service-account*.json
*serviceAccount*.json
.firebase/
firebase-debug.log
.ui-debug.log
